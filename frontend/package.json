{
  "name": "minimax-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MiniMax Studio — AI 视频导演工作台（MiniMaxH3Director 独立前端）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --exclude tests/e2e.verify.test.ts",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-run.mjs",
    "e2e:all": "node scripts/e2e-run.mjs all"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
